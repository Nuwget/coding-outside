{
  "name": "@coding-outside/monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Coding Outside — monitor de sessões de agentes de IA (Claude Code, Codex, Gemini CLI, Copilot CLI, OpenCode, Cursor) com Desk (ESP32), Hub (Tauri), Remote (PWA) e Desk Simulator.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  }
}
